<?xml version="1.0" encoding="utf-8"?>
<!--
  Staff-facing text.

  ENGLISH ONLY, by the owner's decision. §9.9's ar and fr locales are descoped —
  there is no values-ar/ or values-fr/ and adding one is a resource-only change,
  because every layout in this app is written against start/end rather than
  left/right and will mirror correctly without touching Kotlin.

  Two rules that come straight from the spec:

  • Connection state is expressed in OPERATIONAL language, never technical
    (§17.7). Staff must never see the words WebSocket, channel, socket, or sync
    error. An amber "offline" indicator must not read as a fault — the app is
    designed for that state, and a fault-shaped message makes staff stop working.

  • Guest names are never in a string resource. They are rendered exactly as
    stored, never transliterated (§9.9).
-->
<resources>
    <string name="app_name">Fancy Check-in</string>

    <!--
      Setup: welcome, then the three-stop rail every setup screen carries.

      The brand is "Fancy". It is deliberately its own string rather than being
      spliced out of app_name: the wordmark is set in Great Vibes and the words
      "Check-in" beside it are not, so they cannot share one resource.
    -->
    <string name="brand_name">Fancy</string>
    <string name="welcome_product">Check-in</string>
    <string name="welcome_tagline">Scan guests in at the door — with or without internet.</string>
    <string name="welcome_start">Pair this tablet</string>
    <!-- Said before anything is attempted. Preparing a tablet at the venue, on
         the venue\'s wifi, at the hour the guests arrive is the single most
         common way setup goes wrong. -->
    <string name="welcome_internet_notice">Pairing and loading the guest list need internet. Checking guests in does not.</string>

    <string name="setup_step_pair">Pair</string>
    <string name="setup_step_prepare">Prepare</string>
    <string name="setup_step_signin">Sign in</string>
    <string name="setup_step_of">Step %1$d of %2$d</string>
    <!-- The rail on the welcome screen, where no step has been started yet.
         Without this, welcome and pairing rendered an identical rail and the
         one indicator that is supposed to say where you are could not tell two
         consecutive screens apart. -->
    <string name="setup_steps_total">%1$d steps</string>

    <!-- Event selection and preparation (§8.2) -->
    <!-- Was "This tablet", which named the screen instead of saying what to do
         on it. The screen answers one question: can I leave for the venue yet. -->
    <string name="prepare_title">Get this tablet ready</string>

    <!-- Releasing a tablet from its account. Until now nothing in the app could
         undo a pairing, and a device paired to the wrong event had to be
         reinstalled. -->
    <string name="prepare_release">Pair to a different account</string>
    <string name="prepare_release_title">Release this tablet?</string>
    <string name="prepare_release_body">The guest list and this tablet\'s access are removed from the device. You will need a new pairing code to use it again. Check-ins that have already been sent are safe on the server.</string>
    <string name="prepare_release_confirm">Release tablet</string>
    <!-- No format argument: the dialog renders this title without one, and a
         stray %1$d would print literally. The count lives in the body. -->
    <string name="prepare_release_blocked_title">Not yet — check-ins are still on this tablet</string>
    <string name="prepare_release_blocked_body">%1$d check-ins have not reached the server, and releasing the tablet would lose them. Connect to the internet, wait for them to send, then try again.</string>
    <string name="prepare_release_failed">The tablet was not released. Nothing has changed — try again.</string>
    <string name="prepare_which_event">Which event?</string>
    <string name="prepare_choose_another">Choose a different event</string>
    <!-- The one action when the device is armed. "OK" said nothing about what
         would happen next. -->
    <string name="prepare_start">Start check-in</string>
    <string name="prepare_internet_notice">Internet is required now. It will not be required at the venue.</string>
    <string name="prepare_refreshing">Loading…</string>
    <!-- An empty list must explain itself. Silence reads as a broken app, and the
         operator cannot otherwise tell "still loading" from "not assigned". -->
    <string name="prepare_no_events">No events yet. This tablet is paired, but no event has been assigned to its gate — check the dashboard, then tap Refresh.</string>
    <string name="prepare_ready">Ready offline</string>
    <string name="prepare_needs_sync">Needs refresh</string>
    <string name="prepare_not_prepared">Not prepared</string>
    <string name="prepare_download">Download guest list</string>
    <string name="prepare_refresh">Refresh</string>
    <string name="prepare_guest_count">%1$d guests</string>

    <!-- Download progress: real counts, never an indeterminate spinner (§8.2) -->
    <string name="prepare_fetching_manifest">Checking the guest list…</string>
    <string name="prepare_downloading">Downloading %1$d of %2$d guests (page %3$d of %4$d)</string>
    <string name="prepare_verifying">Checking the download is complete…</string>
    <string name="prepare_fetching_artwork">Downloading the event photo…</string>
    <string name="prepare_promoting">Saving to this device…</string>
    <string name="prepare_done">Ready. %1$d guests saved. You can go offline now.</string>

    <!-- Preparation failures. Each is distinct because each needs a different
         action from the operator, and "the download was incomplete" must never
         be presented as success. -->
    <string name="prepare_failed_offline">No internet connection. Connect and try again before you leave.</string>
    <string name="prepare_failed_not_authorised">This device is not authorised for that event.</string>
    <string name="prepare_failed_feature">Check-in is not included in this event\'s plan.</string>
    <string name="prepare_failed_incomplete">The download was incomplete (%1$d of %2$d guests). Nothing was saved. Try again.</string>
    <string name="prepare_failed_corrupted">The guest list did not arrive intact. Nothing was saved. Try again.</string>
    <string name="prepare_failed_server">The server could not be reached (%1$d). Try again.</string>
    <string name="prepare_failed_unknown">Preparation failed. Nothing was saved.</string>

    <!-- Staff login (§8.1) -->
    <string name="login_title">Who is on the door?</string>
    <string name="login_enter_pin">Enter %1$s\'s PIN</string>
    <string name="login_verifying">Checking…</string>
    <string name="login_wrong_pin">Wrong PIN. %1$d attempts left.</string>
    <string name="login_locked_out">Locked for 5 minutes. A supervisor can reset this on this tablet.</string>
    <string name="login_roster_empty">No staff have been added for this event yet.</string>
    <string name="login_role_usher">Usher</string>
    <string name="login_role_supervisor">Supervisor</string>
    <!-- Says where it goes. "Cancel" on a PIN pad is ambiguous: cancel the
         digits, or cancel being this person? -->
    <string name="login_someone_else">Someone else</string>
    <!-- The backspace glyph lives here rather than in Kotlin source. -->
    <string name="keypad_backspace">⌫</string>

    <!-- Device pairing (§18.3) -->
    <string name="pair_title">Pair this tablet</string>
    <!-- Said "the Fancy RSVP dashboard" until the rebrand made that a product
         that no longer exists. It also never said WHERE in the dashboard, which
         is the only part someone who has not seen one needs. -->
    <string name="pair_instructions">Enter the 8-character code from your Fancy dashboard.</string>
    <string name="pair_submit">Pair</string>
    <string name="pair_paste">Paste code</string>
    <string name="pair_paste_nothing">No pairing code in the clipboard. Copy it, then tap Paste again.</string>
    <string name="pair_help_link">Where do I find this code?</string>

    <!--
      The pairing guide.

      Every dashboard label quoted below was read out of the dashboard's source,
      not remembered. An earlier draft of this copy said "Go to Check-in devices,
      tap Add device" — there is no "Add device" button, and it left out the
      seating-map step entirely, which is the one place organizers get stuck.

        "Check-in setup", "Before the event", "Tablets"
            frontend/src/app/dashboard/checkin-setup/page.js
        "Check-in devices", "Gate", "Create pairing code",
        "Add an entrance to your seating map first"
            frontend/src/app/dashboard/components/DeviceManagement.js
        8 characters · no O/0/I/1/L · single use · 10 minutes
            backend/services/checkinDeviceService.js

      Change the dashboard, change these.
    -->
    <string name="howto_link">How do I connect this to Fancy?</string>
    <string name="howto_title">Connect to Fancy</string>
    <string name="howto_step_of">Step %1$d of %2$d</string>
    <!-- "Previous", not "Back". The bar at the bottom of this screen already
         says "Back to pairing", and two controls beginning with the same word,
         100dp apart, doing different things is the exact ambiguity the rest of
         this app is written to avoid. -->
    <string name="howto_back">Previous</string>
    <string name="howto_next">Next</string>
    <string name="howto_finish">Enter the code</string>
    <string name="howto_leave">Back to pairing</string>

    <string name="howto_1_title">Open the dashboard</string>
    <string name="howto_1_body">On a computer or phone — not on this tablet — sign in at fancyrsvp.com and open Check-in setup from the menu. This part needs internet. Checking guests in later does not.</string>

    <string name="howto_2_title">Put an entrance on the map</string>
    <string name="howto_2_body">Every tablet is tied to a gate, and gates come from your seating map. Open the seating map, add an entrance, and give it the name your staff already use for it — “Main entrance”, “Garden gate”.</string>
    <string name="howto_2_note">Skip this and there is no code to create. The Tablets panel will only offer to open the seating map, which is easy to read as something being broken.</string>

    <string name="howto_3_title">Create the pairing code</string>
    <string name="howto_3_body">In Check-in setup, under “Before the event”, choose Tablets. Pick the gate this tablet will stand at, then press Create pairing code. One gate can have several tablets — a busy entrance often runs two.</string>

    <string name="howto_4_title">Type it here</string>
    <string name="howto_4_body">Eight characters, into the boxes on the pairing screen. There is no O, zero, I, one or L in a Fancy code, so anything that looks like one is a different character.</string>
    <string name="howto_4_note">The code lasts 10 minutes and works once. If it runs out, create another — nothing is wasted by doing so.</string>
    <string name="pair_failed_invalid">That code is not valid.</string>
    <string name="pair_failed_expired">That code has expired. Generate a new one.</string>
    <string name="pair_failed_limit">This event already has the maximum number of devices.</string>
    <!-- Shown after the app has been killed by an uncaught error. A tablet has no
         logcat, so this is the only way an operator can report what happened. -->
    <string name="pair_previous_crash">The app closed unexpectedly last time. Please send this to support:</string>
    <string name="pair_dismiss_crash">Dismiss</string>

    <!-- Connection state (§17.7). Operational language only. -->
    <string name="conn_synced">Synced</string>
    <string name="conn_offline_normal">Offline · working normally</string>
    <string name="conn_offline_pending">Offline · %1$d pending</string>
    <string name="conn_needs_attention">Needs attention</string>

    <!-- Data freshness (§19.7) -->
    <string name="freshness_current">Guest list current</string>
    <string name="freshness_from">Guest list from %1$s</string>
    <string name="freshness_stale">Guest list from %1$s · refresh when online</string>

    <!-- Battery warnings (§21.9). These communicate STAKES, not just a level:
         a tablet dying with unsynced check-ins is permanent data loss. -->
    <string name="battery_low">Battery 20%%. Find a charger.</string>
    <string name="battery_critical">Battery 10%%. %1$d check-ins have not been sent yet — they will be lost if this tablet dies.</string>
    <string name="battery_critical_clean">Battery 10%%. Everything has been sent. Find a charger.</string>

    <!-- Scanner (§8.3) -->
    <string name="scanner_hint">Hold the guest\'s code inside the frame</string>
    <string name="scanner_torch_on">Light on</string>
    <string name="scanner_torch_off">Light off</string>
    <string name="scanner_search">Search by name</string>
    <string name="scanner_counter">%1$d of %2$d arrived</string>
    <!-- Camera permission denial must degrade to manual search, never a dead
         screen (§8.3). Every one of these leads with what still works, because
         the person reading it has a queue in front of them.

         THREE bodies, not one, because there are three different ways out and
         the old single message pointed all of them at "Allow camera" — a button
         Android answers instantly and silently once the permission has been
         refused for good. -->
    <!-- Shown over a black preview while CameraX brings the camera up. A cold
         tablet takes a moment, and an unexplained black rectangle is
         indistinguishable from a broken one. -->
    <string name="scanner_camera_starting">Starting camera…</string>
    <string name="scanner_no_camera_title">Camera not available</string>
    <string name="scanner_camera_permission_title">Camera is switched off</string>
    <string name="scanner_camera_denied_body">Scanning needs the camera. You can still check guests in by name — everything else works normally.</string>
    <string name="scanner_camera_blocked_body">Camera access is blocked for this app, so the prompt will not appear again. Open Settings and allow the camera. You can keep checking guests in by name in the meantime.</string>
    <string name="scanner_camera_failed_body">The camera did not start. Close any other app using it, then try again. You can keep checking guests in by name in the meantime.</string>
    <string name="scanner_grant_camera">Allow camera</string>
    <string name="scanner_open_settings">Open settings</string>
    <string name="scanner_camera_retry">Try camera again</string>

    <!-- The self-service kiosk, where the SAME screen is the normal state.
         The kiosk has no back camera and usually no usable camera at all, so
         reaching the fallback there is not a fault — it is Tuesday. Telling
         staff "Camera not available" beside a scanner that is working perfectly
         teaches them the machine is broken, and the next real fault gets
         ignored. When the hardware scanner has answered, these two replace the
         headline and the body; the camera recovery button stays below, because
         a camera that could work is still worth offering. -->
    <string name="scanner_hardware_ready_title">Ready to scan</string>
    <string name="scanner_hardware_ready_body">Hold the guest\'s code up to the scanner. You can also check guests in by name.</string>

    <!--
      Scan result states (§8.4).

      FIVE, from six outcomes. "Wrong event" and "Not on the list" both mean a
      PERSON the tablet cannot place, and both ask the same thing of the usher —
      search by name — so they share one calm, colourless state.

      "Not a Fancy code" was folded in with them and has been pulled back out. It
      is not about a person at all: the scanner read something that was never an
      invitation, so telling an usher to search by name sent them to a text field
      with nothing to type. It has its own red state and its own words.
    -->
    <string name="result_welcome">Welcome</string>
    <string name="result_welcome_vip">VIP guest</string>
    <!-- A small tracked label above the number, not "Table 12" set together:
         the part read across a room is the number alone, at full size. -->
    <string name="result_table_label">Table</string>
    <string name="result_no_table">No table assigned</string>
    <string name="result_admit">Check in</string>
    <string name="result_admit_all">Check in all %1$d</string>
    <string name="result_not_everyone">Not everyone? Choose who</string>
    <string name="result_choose_who">Who is arriving?</string>
    <string name="result_already_title">Already checked in</string>
    <string name="result_override">Supervisor override</string>
    <string name="result_override_unavailable">A supervisor is needed to check this guest in again.</string>
    <string name="result_not_found_title">Not on tonight\'s list</string>
    <string name="result_not_found_body">We can\'t place this code</string>
    <string name="result_not_found_code">Valid, and issued for this event</string>
    <string name="result_not_found_hint">A different spelling, or booked under someone else in their party</string>

    <!--
      Row labels for the scan result. Short, because they sit in a fixed 96dp
      column beside the value; anything longer is truncated rather than wrapped.
    -->
    <string name="result_fact_party">Party</string>
    <string name="result_fact_meal">Meal</string>
    <string name="result_fact_note">Note</string>
    <string name="result_fact_rule">Rule</string>
    <string name="result_fact_ticket">Ticket</string>
    <string name="result_fact_arrived">Arrived</string>
    <string name="result_fact_by">By</string>
    <string name="result_fact_code">Code</string>
    <string name="result_fact_likely">Likely</string>
    <string name="result_fact_read">Read</string>
    <string name="result_fact_next">Next</string>
    <string name="result_already_progress">%1$d of %2$d already in</string>

    <!--
      A code that is not one of ours (§8.4). Deliberately says nothing about the
      guest: nobody has been refused, the scanner simply read something that was
      never an invitation. "Not from this event" would be wrong — that is the
      not-found screen above.
    -->
    <string name="result_foreign_label">Unrecognised code</string>
    <string name="result_foreign_title">This isn\'t an invitation</string>
    <string name="result_foreign_read">A code that wasn\'t issued for this event</string>
    <string name="result_foreign_body">Ask the guest to open their invitation, or find them by name</string>
    <string name="result_foreign_done">Next guest</string>
    <!-- Quiet line on an otherwise normal welcome. §5.3: the door is never
         blocked by uncertainty, so this is a note, not a state. -->
    <string name="result_expired_note">Ticket was past its date</string>
    <string name="result_party_of">Party of %1$d</string>
    <string name="result_meal">Meal: %1$s</string>
    <string name="result_dietary">Dietary: %1$s</string>
    <string name="result_no_kids">No children at this event</string>

    <!-- Manual search (§8.5) -->
    <string name="search_hint">Name or table</string>
    <string name="search_prompt">Start typing a guest\'s name.</string>
    <string name="search_no_results">No guests match \"%1$s\"</string>
    <string name="search_arrived_badge">Arrived</string>

    <!--
      Navigation.

      "Back to scanner" is written out in full on every screen. A bare arrow is
      not enough: staff are hired that night, and an icon that means "up" to a
      designer means nothing to someone holding a tablet for the first time.
    -->
    <string name="nav_menu">Menu</string>
    <string name="nav_back_to_scanner">Back to scanner</string>

    <!-- The menu (§8.6) -->
    <string name="menu_title">Tonight</string>
    <string name="menu_when_they_came">When they arrived</string>
    <string name="menu_guests_detail">Search everyone, see who is still out</string>
    <string name="menu_entrance_detail">Full-screen arrival counter for the lobby</string>
    <string name="menu_close_detail">End the event and remove its data from this tablet</string>
    <string name="menu_crash_title">Problem report</string>
    <string name="menu_crash_detail">The app closed unexpectedly. Open this and send it to support</string>
    <string name="dashboard_loading">Loading…</string>
    <string name="dashboard_open_guests">Guest list</string>
    <string name="dashboard_entrance_display">Entrance display</string>
    <string name="dashboard_of_invited">of %1$d invited</string>
    <string name="dashboard_by_category">By category</string>
    <string name="dashboard_arrived_of">%1$d of %2$d arrived</string>
    <!-- Supervisor-only block (§18.2). Hidden from ushers as noise, not as secret. -->
    <string name="dashboard_pending">Waiting to send</string>
    <string name="dashboard_stalled">Stuck — needs attention</string>
    <string name="dashboard_conflicts">Duplicate admissions</string>
    <string name="dashboard_per_staff">Checked in by</string>
    <string name="dashboard_unattributed">Not attributed</string>

    <!-- Guest list (§8.7) -->
    <string name="guests_title">Guests</string>
    <string name="guests_showing">%1$d shown</string>
    <string name="guests_none">No guests match these filters</string>
    <!-- An empty list is almost always a filter left on from the last question
         somebody asked, so the way out is offered rather than described. -->
    <string name="guests_clear_filters">Show everyone</string>
    <string name="guests_not_arrived">Not arrived</string>
    <string name="guests_all_tables">All tables</string>
    <string name="guests_filter_all">All</string>
    <string name="guests_filter_arrived">Arrived</string>
    <string name="guests_filter_not_arrived">Not arrived</string>
    <string name="guests_filter_vip">VIP</string>

    <!-- Supervisor undo (§9.6). The reason is mandatory. -->
    <string name="guests_undo">Undo check-in</string>
    <string name="guests_undo_title">Undo %1$s\'s check-in?</string>
    <string name="guests_undo_body">The arrival stays in the record, marked as reversed. A reason is required.</string>
    <string name="guests_undo_reason">Reason</string>
    <string name="guests_undo_failed">Could not undo. Check the reason and try again.</string>

    <!-- Entrance display (§8.8). Guest-facing: no names, no operational state. -->
    <string name="entrance_waiting">Preparing…</string>
    <string name="entrance_guests_arrived">guests arrived</string>
    <!-- The only control on the screen. Small and low-contrast so a passing
         guest does not read it as an invitation, but a real 72dp target. -->
    <string name="entrance_exit">Exit</string>
    <string name="entrance_exit_confirm">Leave display mode?</string>

    <!-- Session lock (§20.4) -->
    <string name="session_locked_title">Locked</string>
    <string name="session_locked_body">Enter %1$s\'s PIN to continue, or hand over to another staff member.</string>
    <string name="session_switch_staff">Switch staff</string>

    <!-- Close event and purge (§20.5) -->
    <string name="close_title">Close event</string>
    <string name="close_ready">%1$d of %2$d guests arrived. All check-ins have been sent.</string>
    <string name="close_purge">Delete guest list from this tablet</string>
    <string name="close_purge_explain">The guest list, staff PINs and arrival records are removed from this device. The event\'s data stays on the server.</string>
    <!-- BLOCKED, not merely discouraged (§20.5). Those check-ins exist nowhere else. -->
    <string name="close_blocked_title">Cannot close yet</string>
    <string name="close_blocked_body">%1$d check-ins have not reached the server. Deleting now would lose them permanently.</string>
    <string name="close_blocked_stalled">%1$d of them are stuck and will not send on their own — get help before closing.</string>
    <string name="close_retry_sync">Try sending now</string>
    <string name="close_purged">Guest list removed from this tablet.</string>
    <string name="close_purging">Removing…</string>

    <!-- Storage guard at preparation (§21.9) -->
    <string name="prepare_no_space">Not enough free space on this tablet for %1$d guests. Free some space before leaving.</string>

    <string name="action_ok">OK</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_retry">Try again</string>
</resources>
