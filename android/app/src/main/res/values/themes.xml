<?xml version="1.0" encoding="utf-8"?>
<!--
  A minimal host theme. The real visual layer lives in Compose (ui/theme), so
  this only has to give the Activity a sane window before the first composition.

  The window background is PARCHMENT, not charcoal. The app is a light product
  by deliberate choice (see FancyCheckinTheme), and the previous dark window
  meant every cold start flashed a near-black screen before the first frame —
  which at a door reads as the app having crashed and reopened.

  windowLightStatusBar follows: dark icons on a light bar.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FancyCheckin" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/parchment</item>
        <!--
          These three are now OVERRIDDEN AT RUNTIME and changing them here has no
          effect. MainActivity calls enableEdgeToEdge(SystemBarStyle.light(...)),
          which makes both bars transparent and forces dark icons; from API 35 the
          two colour attributes are no-ops anyway.

          Kept rather than deleted because they still describe the intent, and they
          are what a device would fall back to if the runtime call were ever
          removed. Change MainActivity, not this, if the bars need to look
          different.
        -->
        <item name="android:statusBarColor">@color/parchment</item>
        <item name="android:navigationBarColor">@color/parchment</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>
