<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      The camera is required for scanning, but the app must still INSTALL and
      run on a device without one: spec §8.3 requires camera-permission denial
      to degrade gracefully to manual search rather than to a dead screen, and
      the same reasoning applies to hardware that simply has no camera.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!--
      camera.front and camera.any are declared because the scanner now FALLS BACK
      to the front lens when a device has no rear one (see CameraPreview) — a real
      class of cheap tablet, and exactly the kind bought in sixes for a door.
      camera.flash is declared for the same honesty: the torch control is hidden
      outright on hardware with no lamp rather than offered and inert.

      Every one is required="false". Declaring a feature without that is what
      makes Google Play hide the app from devices that lack it, and this app must
      install on all of them — §8.3's degradation to manual search is not a
      consolation path, it is a supported way to run the door.
    -->

    <application
        android:name=".CheckinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FancyCheckin"
        tools:targetApi="35">

        <!--
          allowBackup=false and fullBackupContent=false are deliberate and not
          negotiable (spec §20). The local database holds the complete guest
          list of a private event; letting it flow into a cloud backup or an adb
          backup would defeat the encryption-at-rest requirement entirely.
        -->

        <!--
          WorkManager's default initialiser is removed so CheckinApp can supply a
          HiltWorkerFactory. Without this, the sync worker cannot be given the
          database or the API and WorkManager throws on instantiation.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.FancyCheckin">
            <!--
              Orientation is locked (§21.9). An unexpected rotation mid-scan
              disrupts the CameraX pipeline and confuses staff at the door.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
