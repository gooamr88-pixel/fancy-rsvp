<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Lets the app ASK the system to install a newer build of itself, which is
      how a tablet gets updated without somebody uninstalling and reinstalling by
      hand. It installs nothing on its own: from API 26 this is a per-app setting
      the operator grants in Settings, so holding the permission is necessary and
      not sufficient — UpdateRepository.canInstall() checks the grant and sends
      them there when it is missing.

      The APK is verified against the SHA-256 in the published manifest before it
      is ever handed over, and Android refuses any package whose signing key
      differs from the installed app's — so this cannot be used to replace the
      app with something else.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      The camera is required for scanning, but the app must still INSTALL and
      run on a device without one: spec §8.3 requires camera-permission denial
      to degrade gracefully to manual search rather than to a dead screen, and
      the same reasoning applies to hardware that simply has no camera.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!--
      camera.front and camera.any are declared because the scanner now FALLS BACK
      to the front lens when a device has no rear one (see CameraPreview) — a real
      class of cheap tablet, and exactly the kind bought in sixes for a door.
      camera.flash is declared for the same honesty: the torch control is hidden
      outright on hardware with no lamp rather than offered and inert.

      Every one is required="false". Declaring a feature without that is what
      makes Google Play hide the app from devices that lack it, and this app must
      install on all of them — §8.3's degradation to manual search is not a
      consolation path, it is a supported way to run the door.
    -->

    <application
        android:name=".CheckinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FancyCheckin"
        tools:targetApi="35">

        <!--
          allowBackup=false and fullBackupContent=false are deliberate and not
          negotiable (spec §20). The local database holds the complete guest
          list of a private event; letting it flow into a cloud backup or an adb
          backup would defeat the encryption-at-rest requirement entirely.
        -->

        <!--
          WorkManager's default initialiser is removed so CheckinApp can supply a
          HiltWorkerFactory. Without this, the sync worker cannot be given the
          database or the API and WorkManager throws on instantiation.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Shares ONE thing with ONE other process: the downloaded APK, with the
          system package installer.

          Since API 24 a file:// URI in an intent throws FileUriExposedException,
          so a content:// URI is the only way to hand the installer a file at
          all. The read grant is per-intent (FLAG_GRANT_READ_URI_PERMISSION) and
          dies with it.

          The path set in @xml/file_paths is deliberately the update directory
          alone. Exposing files-path with an empty path would publish the whole
          of filesDir — which on this app holds the encrypted database and the
          cached event photographs — to anything holding a grant.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="${screenOrientation}"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.FancyCheckin">
            <!--
              Orientation follows the sensor (fullSensor), and §21.9's lock is
              retired. It existed because an unexpected rotation was thought to
              disrupt the CameraX pipeline — but that only happens when the
              Activity is RECREATED, and the configChanges below have always
              prevented exactly that. Compose re-measures and the camera keeps
              running.

              fullSensor, not fullUser: fullUser obeys the device's auto-rotate
              lock, which is off by default on most tablets, and then the app
              never rotates at all. See build.gradle.kts.

              It stays a build placeholder so a single venue can still pin one
              unit — SCREEN_ORIENTATION=userPortrait — without a new variant.
              See build.gradle.kts.

              keyboard|navigation were added to configChanges for the kiosk
              scanner. Android treats attaching or detaching an input device as a
              configuration change, and without these two qualifiers declared, the
              scanner waking, sleeping or being unplugged RECREATES THE ACTIVITY —
              tearing down and rebuilding the CameraX pipeline underneath an usher
              mid-shift. The manufacturer's own HID sample declares exactly these,
              which is how the problem was found.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
