# ============================================================================
#  Fancy RSVP — PRODUCTION environment (fancyrsvp.com)
#  Copy this file to `.env` on the production server and fill the SECRET values.
#  NEVER commit the filled-in file. Keep secrets out of git and ecosystem.config.js.
#
#  Legend:  <FILL>  = you must paste a real secret      (•) = pre-set, leave as-is
# ============================================================================

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public browser origin(s). Comma-separated allowlist — doubles as CORS list AND
# the Stripe Checkout return-URL allowlist. Include BOTH apex and www so a user
# who started on either lands back on the SAME origin (a mismatch logs them out).
FRONTEND_URL=https://fancyrsvp.com,https://www.fancyrsvp.com
# Public base of the API (used to build QR / invitation links). Same domain, /api.
BACKEND_URL=https://fancyrsvp.com
# NOTE: `trust proxy` is set in code (app.js) — no env var needed. It makes the
# rate limiters and req.protocol work correctly behind nginx.

# ── Auth / security secrets (REQUIRED — app refuses to boot without these) ────
JWT_SECRET=<FILL: long random string, e.g. `openssl rand -hex 32`>
QR_JWT_SECRET=<FILL: a DIFFERENT long random string>
IP_HASH_SALT=<FILL: random 32-byte hex for analytics IP hashing>
GOOGLE_CLIENT_ID=<FILL: production Google OAuth client id>.apps.googleusercontent.com

# ── Supabase (PRODUCTION project — same DB the cutover SQL runs against) ──────
SUPABASE_URL=https://<FILL-prod-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<FILL: PRODUCTION service_role key — never expose to the browser>

# ── Feature flags: go-live switches ──────────────────────────────────────────
# Both must be `true` to actually charge cards / send real SMS, and BOTH also
# require their credentials to be present (belt-and-suspenders against half-config):
# Stripe needs STRIPE_SECRET_KEY; SMS needs the full credential set for whichever
# carrier SMS_PROVIDER selects (see the SMS carrier section below). A partial
# configuration reports SMS as disabled rather than silently accepting sends it
# cannot deliver.
PAYMENTS_STRIPE_ENABLED=true
SMS_ENABLED=true

# ── Stripe (LIVE account — the new email/account, NOT the test account) ───────
# Required only because PAYMENTS_STRIPE_ENABLED=true above.
STRIPE_SECRET_KEY=<FILL: sk_live_... from the NEW Live account>
# The signing secret of the LIVE webhook endpoint you create at:
#   https://fancyrsvp.com/api/v1/payments/webhook   (events: checkout.session.completed,
#   charge.refunded, charge.dispute.created, charge.dispute.updated, charge.dispute.closed)
STRIPE_WEBHOOK_SECRET=<FILL: whsec_... from the LIVE endpoint (distinct from test)>

# ── Twilio (real SMS) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=<FILL: live AC... SID>
TWILIO_AUTH_TOKEN=<FILL: live auth token>
# The VERIFIED TOLL-FREE number from the Toll-Free Verification submission —
# NOT a local 10-digit number and NOT the +15005550006 magic test number.
TWILIO_PHONE_NUMBER=<FILL: +18XXXXXXXXX toll-free>
# Optional. WhatsApp sender for the organizer's new-RSVP notification. Leave unset
# unless a real WhatsApp sender is provisioned — the previous hardcoded fallback
# was Twilio's public sandbox number, which reached nobody in production.
# TWILIO_WHATSAPP_FROM=<FILL: +1XXXXXXXXXX WhatsApp-enabled sender>
# Set EXPLICITLY. Behind nginx the auto-derived URL would be http:// and break
# Twilio signature verification → no delivery reconciliation / auto-refunds.
SMS_STATUS_CALLBACK_URL=https://fancyrsvp.com/api/v1/public/sms/status
# Inbound-message webhook (STOP/HELP opt-out recording). Must match the
# "A message comes in" URL configured on the number in the Twilio Console
# (deployment/README.md Step 8) or signature verification rejects the calls.
SMS_INBOUND_WEBHOOK_URL=https://fancyrsvp.com/api/v1/public/sms/inbound

# ── SMS carrier ──────────────────────────────────────────────────────────────
# Which carrier actually sends. Default `twilio` = the behaviour that was here
# before Vonage existed. Everything above the transport (consent, STOP, billing,
# refunds) is identical either way, so this is a one-line switch and a restart.
#   twilio | vonage
SMS_PROVIDER=twilio

# ── Vonage (used only when SMS_PROVIDER=vonage) ──────────────────────────────
# Built on the SMS API, so these three are the whole credential set — no
# Application, no JWT, no private key on disk. See docs/SMS-Provider-Setup.md.
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Your Vonage number. Stored +E.164 here; the leading + is stripped on send.
VONAGE_FROM=+1XXXXXXXXXX
# REQUIRED in production. Delivery receipts trigger automatic refunds, so an
# UNSIGNED receipt endpoint would let anyone forge a failure and credit a wallet.
# Without this the status webhook refuses every request (fails closed). Inbound
# STOP is still accepted unsigned — dropping a real STOP is worse (fails safe).
VONAGE_SIGNATURE_SECRET=
# Must match the hash chosen in the Vonage dashboard.
#   md5hash | md5 | sha1 | sha256 | sha512
VONAGE_SIGNATURE_METHOD=sha256
# Does VONAGE answer the mandatory HELP keyword itself? Unset/false = WE send the
# HELP reply. Opt-Out Assist (Vonage's keyword service) is documented for 10DLC and
# short codes, is opt-in, and does not list toll-free — so on a toll-free number we
# must assume it is ours to answer. Set true ONLY after confirming with Vonage;
# otherwise the guest gets two replies. STOP is different and needs nothing here:
# it is enforced network-side on toll-free and the carrier sends its own
# confirmation, which is why we never reply to STOP on either carrier.
# VONAGE_CARRIER_HELP=false

# ── Brevo (transactional email: receipts, activation, invitations) ───────────
BREVO_API_KEY=<FILL: production Brevo API key>
BREVO_FROM_EMAIL=info@fancyrsvp.com
BREVO_FROM_NAME=Fancy RSVP
# The ONE business address for the whole platform (also /contact, /terms,
# /privacy, /sms-opt-in and CONTACT_NOTIFY_EMAIL). Keep it a real, monitored
# mailbox — Twilio TFV and Yahoo/Gmail both check it.
# fancyrsvp.com MUST be authenticated in Brevo (DKIM CNAMEs + spf.brevo.com in
# the domain's single SPF record), or Yahoo rejects with 554 5.7.9 DMARC fail.

# ── Cloudflare Turnstile (CAPTCHA on public RSVP — recommended vs spam) ───────
# If left blank, the CAPTCHA check is disabled (RSVP still works).
TURNSTILE_SECRET=<FILL or leave blank to disable>

# ── Background workers (sensible defaults; shown for clarity) ─────────────────
# Daily-revenue rollup for finance reporting — ON by default. Leave enabled.
# REVENUE_ROLLUP_ENABLED=true
#
# ── LIFECYCLE MESSAGING — SET THIS TO true ON ANY LIVE DEPLOYMENT ────────────
# This flag does NOT only cover "event details changed" emails, which is what
# this file used to say. It is the master switch for EVERY automatic message a
# guest or organizer receives:
#
#   • the day-before reminder — their table, the venue and their QR entry pass,
#     by email AND by SMS (services/emailScheduler.js → jobEventReminders)
#   • RSVP reminders to guests who have not replied
#   • the organizer's final headcount report
#   • post-event thank-you messages
#   • "the date/venue changed" notices
#
# Left unset, the scheduler no-ops and NONE of the above is ever sent. Nothing
# errors and nothing retries — the first symptom is a guest arriving without
# their table. The server now logs a WARN at boot when it is off; check for
# "[email-scheduler] DISABLED" in pm2 logs if guests report missing reminders.
EMAIL_AUTOMATION_ENABLED=true
# How often the sweep runs, in minutes (min 5, default 15).
# EMAIL_SCHEDULER_INTERVAL_MIN=15
#
# SMS_WORKER_ENABLED is GONE — the campaign queue it drained was removed in the
# four-type SMS rebuild. Delete it from any env file you still have it in.
#
# ── The three run-up marks ───────────────────────────────────────────────────
# Guests are reminded three times, and each mark is a separate promise:
#   T-24h  email  their table and entry pass
#   T-6h   email  the final call, with directions
#   T-2h   TEXT   the same table and pass, on their phone
# All three fire on the mark (a self-aligning alarm), not on the 15-minute
# sweep. Overridable in MINUTES — the names end _MIN deliberately, so a mistyped
# value is a wrong time rather than a 90-millisecond window that reminds nobody.
# The text's window MUST stay below the other two or it arrives first.
# EVENT_REMINDER_WINDOW_MIN=1440
# FINAL_CALL_WINDOW_MIN=360
# SMS_REMINDER_WINDOW_MIN=120

# ── POST-EVENT DATA PURGE — DESTRUCTIVE, OFF BY DEFAULT ──────────────────────
#
# When an event finishes, the organizer is emailed a warning and then EVERYTHING
# belonging to that event is permanently deleted: guests, RSVPs, seating,
# check-in records, message history and the public guest page. It cannot be
# recovered, by us or by them.
#
# Opt-IN, unlike DRAFT_CLEANUP_ENABLED below, and the asymmetry is deliberate:
# that one removes never-launched placeholder rows nobody has ever seen, this one
# removes paid events with real guest lists in them.
#
# The organizer gets a download link for a full spreadsheet archive, and the
# clock starts when the WARNING IS SENT — never when the event ended — so a
# scheduler outage delays the deletion rather than skipping the notice.
# EVENT_PURGE_ENABLED=true
#
# Hours between the warning and the deletion (min 1, default 24).
# PURGE_GRACE_HOURS=24
# Assumed run time for an event with no explicit end time (default 6). Most
# organizers never set events.event_end_date, so without this the purge would
# simply not run for the majority of events.
# PURGE_ASSUMED_DURATION_HOURS=6
# Offer the organizer a "keep my data" link in the warning email (default true).
# PURGE_ALLOW_OPT_OUT=true
# How often the warn+purge sweep runs, in minutes (min 5, default 30).
# EVENT_PURGE_INTERVAL_MIN=30

# ── Optional infra ───────────────────────────────────────────────────────────
# Shared rate-limit store across pm2 cluster workers. Without it each worker keeps
# its own counters (effective limit ≈ N×). Set if you run Redis.
# REDIS_URL=redis://127.0.0.1:6379
# LOG_LEVEL=info
# DANGER: never set DISABLE_RATE_LIMIT in production. Load-testing only.
